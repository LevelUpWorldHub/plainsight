# Copy to .env.local. Never commit real keys.
# Firebase console → Project settings → Your apps → Web app.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Score-based reCAPTCHA Enterprise site key registered for App Check.
# Do not add localhost to a key that will be used in production.
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Local only. Set to true to print an App Check debug token in the console.
# Register that token under App Check → Apps → Manage debug tokens.
# Never enable this in a production build.
NEXT_PUBLIC_APPCHECK_DEBUG=false

# Cloud model used only after the user agrees to send already-redacted text.
NEXT_PUBLIC_FIREBASE_CLOUD_MODEL=gemini-3.5-flash-lite
